@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Load exported targets first
include("${CMAKE_CURRENT_LIST_DIR}/instrument-target-targets.cmake")

# If Lua target exists, expose dependency
if(TARGET instrument-target::instrument-target-lua)
    find_dependency(Lua)
endif()

# Supported components
set(_supported_components lua)

foreach(_comp ${instrument_target_FIND_COMPONENTS})
    if(NOT _comp IN_LIST _supported_components)
        message(FATAL_ERROR "Unsupported component: ${_comp}")
    endif()

    if(_comp STREQUAL "lua")
        if(NOT TARGET instrument-target::instrument-target-lua)
            set(instrument-target_lua_FOUND FALSE)
        else()
            set(instrument-target_lua_FOUND TRUE)
        endif()
    endif()
endforeach()

check_required_components(instrument-target)
