prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@
Name: instrument-target
Description: A insturment target implemenation in C99 for use by Cpp, Go, and Lua
Version: @PROJECT_VERSION@
Libs: -L${libdir} -linstrument-target
Cflags: -I${includedir}
